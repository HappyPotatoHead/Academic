		{"id":"d809bfcfd9f68875","type":"text","text":"red - alert\nblue - categories `#ADD8E6` \ngreen - Elaboration `#228B22`","x":-4421,"y":-509,"width":370,"height":178,"color":"1"},
		{"id":"191b1a8ade28b996","type":"text","text":"Content may be more limited for this","x":-4345,"y":-170,"width":290,"height":92,"color":"1"},
