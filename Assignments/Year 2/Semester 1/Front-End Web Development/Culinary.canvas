		{"id":"98371b0e8d77a623","type":"text","text":"There's no age restrictions and limit to cooking. \nAnyone can cook","x":-4233,"y":1209,"width":282,"height":168,"color":"#228b22"},
		{"id":"abf3a66033d57fa0","type":"text","text":"Malaysians and non-Malaysians","x":-3807,"y":1320,"width":280,"height":83,"color":"#228b22"},
