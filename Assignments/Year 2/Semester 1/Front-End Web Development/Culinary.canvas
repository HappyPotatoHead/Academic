{
	"nodes":[
		{"id":"d51f114e172783b7","type":"text","text":"Make cooking fun for everyone","x":-3515,"y":1580,"width":250,"height":80,"color":"#228b22"},
		{"id":"861917c9cd556684","type":"text","text":"Make cooking fun for both genders","x":-3456,"y":1209,"width":252,"height":113,"color":"#228b22"},
